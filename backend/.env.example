# Database
DATABASE_URL=sqlite:///./modelgate.db
# For PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost/modelgate

# Security
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Demo mode (true = demo provider enabled by default)
DEMO_MODE=true

# Provider credentials (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true
